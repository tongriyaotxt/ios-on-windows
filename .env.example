# 复制成 .env，然后由 scripts/ios.ps1 自动加载（也支持直接设成用户环境变量）
#
# App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_KEY_ID=ABCDE12345
ASC_ISSUER_ID=11111111-2222-3333-4444-555555555555
ASC_KEY_PATH=secrets/AuthKey_ABCDE12345.p8
#
# App Store Connect 里 App 的数字 ID（不是 bundle id）
ASC_APP_ID=6471234567
#
# Apple Developer Team ID，10 位
TEAM_ID=ABCDE12345
#
# 工程标识
BUNDLE_ID=com.tongriyaotxt.appcore
